destroy table inet dotfiles_ci
table inet dotfiles_ci {
  set non_public_v4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
      172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16,
      198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3
    }
  }

  set attic_endpoints {
    type ipv4_addr . inet_service
  }

  chain input {
    type filter hook input priority -10; policy accept;
    iifname "virbr-ci" ip saddr 192.168.186.2 ct state { established, related } accept
    iifname "virbr-ci" ip saddr 192.168.186.2 ip daddr . tcp dport @attic_endpoints accept
    iifname "virbr-ci" drop
    ip daddr . tcp dport @attic_endpoints drop
  }

  chain forward {
    type filter hook forward priority -10; policy accept;
    iifname "virbr-ci" jump egress
    oifname "virbr-ci" ct state { established, related } accept
    oifname "virbr-ci" drop
  }

  chain egress {
    meta nfproto != ipv4 drop
    ip saddr != 192.168.186.2 drop
    oifname "tailscale0" drop
    ip daddr @non_public_v4 drop
    ip daddr { 9.9.9.9, 149.112.112.112 } udp dport 53 accept
    ip daddr { 9.9.9.9, 149.112.112.112 } tcp dport 53 accept
    tcp dport 443 accept
    udp dport 123 accept
    drop
  }
}
