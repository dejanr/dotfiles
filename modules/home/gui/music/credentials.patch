+import { readFileSync } from 'node:fs';
@@ -69,0 +71,24 @@
+const readServerCredentials = (): { username: string; password: string } | null => {
+    const file = process.env.SERVER_CREDENTIALS_FILE;
+    if (!file) return null;
+
+    try {
+        const credentials = JSON.parse(readFileSync(file, 'utf8')) as {
+            username?: unknown;
+            password?: unknown;
+        } | null;
+
+        if (
+            typeof credentials?.username === 'string' &&
+            typeof credentials.password === 'string' &&
+            credentials.username.length > 0 &&
+            credentials.password.length > 0
+        ) {
+            return { username: credentials.username, password: credentials.password };
+        }
+    } catch {}
+
+    console.error('Unable to load valid server credentials from SERVER_CREDENTIALS_FILE');
+    return null;
+};
+
