input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        dwt
        natural-scroll
    }

    focus-follows-mouse
}

environment {
    QT_QPA_PLATFORM "wayland;xcb"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    NIXOS_OZONE_WL "1"
}

workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "10" {
    layout {
        default-column-width { proportion 0.5; }
        preset-column-widths {
            proportion 0.5
        }
    }
}

hotkey-overlay {
    skip-at-startup
}

gestures {
    hot-corners {
        off
    }
}

animations {
    off
}

overview {
    zoom 0.25
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

layer-rule {
    match namespace="dms:blurwallpaper"
    place-within-backdrop true
}

include "managed/appearance.kdl"
include "managed/windowrules.kdl"
include "managed/binds.kdl"
include "managed/dejli-shortcuts.kdl"
include optional=true "dejli/shortcuts.kdl"

include optional=true "dms/layout.kdl"
include optional=true "dms/alttab.kdl"
include optional=true "dms/colors.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/wpblur.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/input.kdl"
include optional=true "dms/windowrules.kdl"
include optional=true "dms/binds.kdl"
