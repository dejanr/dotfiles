+function primarySelectionCommands(operation: "read" | "write"): [string, string[]][] {
+	const commands: [string, string[]][] = [];
+	if (platform() !== "linux") return commands;
+	if (process.env.WAYLAND_DISPLAY) {
+		commands.push(
+			operation === "read"
+				? ["wl-paste", ["--primary", "--no-newline", "--type", "text"]]
+				: ["wl-copy", ["--primary"]],
+		);
+	}
+	if (process.env.DISPLAY) {
+		commands.push(
+			operation === "read" ? ["xclip", ["-selection", "primary", "-out"]] : ["xclip", ["-selection", "primary"]],
+			operation === "read" ? ["xsel", ["--primary", "--output"]] : ["xsel", ["--primary", "--input"]],
+		);
+	}
+	return commands;
+}
+
+export async function readPrimarySelection(): Promise<string | null> {
+	for (const [command, args] of primarySelectionCommands("read")) {
+		const bytes = await runClipboardCommand(command, args, { timeoutMs: 5000 });
+		if (bytes !== undefined) return bytes.toString("utf8") || null;
+	}
+	return null;
+}
+
+export async function copyToPrimarySelection(text: string): Promise<void> {
+	const commands = primarySelectionCommands("write");
+	for (const [command, args] of commands) {
+		if ((await runClipboardCommand(command, args, { input: text, timeoutMs: 5000 })) !== undefined) return;
+	}
+	if (commands.length > 0) throw new Error("Copied to clipboard, but PRIMARY selection is unavailable");
+}
+
 /** Read file paths, such as Finder file copies, from the native clipboard. */
 export async function readClipboardFilePaths(): Promise<string[] | null> {
 	const paths = await getNativeClipboard()?.getFilePaths?.();
