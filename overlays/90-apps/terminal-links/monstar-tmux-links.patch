+fn sameOscHyperlink(a: vt.Pin, b: vt.Pin) bool {
+    const a_page = a.node.page();
+    const b_page = b.node.page();
+    const a_cell = a.rowAndCell().cell;
+    const b_cell = b.rowAndCell().cell;
+    if (!a_cell.hyperlink or !b_cell.hyperlink) return false;
+    const a_id = a_page.lookupHyperlink(a_cell) orelse return false;
+    const b_id = b_page.lookupHyperlink(b_cell) orelse return false;
+    const a_entry = a_page.hyperlink_set.get(a_page.memory, a_id);
+    const b_entry = b_page.hyperlink_set.get(b_page.memory, b_id);
+    return a_entry.eql(a_page.memory, b_entry, b_page.memory);
+}
+
+fn oscHyperlinkRange(self: *App, pin: vt.Pin) ?Renderer.LinkRange {
+    const pages = &self.term.screens.active.pages;
+    const top = pages.getTopLeft(.viewport);
+    const rows = self.term.rows +| @intFromBool(self.scroll_offset != 0);
+    const bottom = pages.pin(.{ .viewport = .{ .x = self.term.cols - 1, .y = rows - 1 } }) orelse
+        pages.getBottomRight(.viewport).?;
+    var start = pin;
+    var end = pin;
+    // Only visible cells can contribute to the hovered link's render range.
+    while (!start.eql(top)) {
+        const previous = start.leftWrap(1) orelse break;
+        if (!sameOscHyperlink(pin, previous)) break;
+        start = previous;
+    }
+    while (!end.eql(bottom)) {
+        const next = end.rightWrap(1) orelse break;
+        if (!sameOscHyperlink(pin, next)) break;
+        end = next;
+    }
+    return self.linkRange(.init(start, end, false));
+}
+
+fn linkHandledLocally(uri: []const u8, mouse_reporting: bool) bool {
+    return !mouse_reporting or
+        std.ascii.startsWithIgnoreCase(uri, "https://") or
+        std.ascii.startsWithIgnoreCase(uri, "http://");
+}
