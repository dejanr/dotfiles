 void
+tty_mouse_pointer(struct tty *tty, int pointer)
+{
+	if (~tty->flags & TTY_STARTED)
+		return;
+	if (!pointer && !tty->mouse_pointer)
+		return;
+
+	/*
+	 * Modifier-only events can reset the terminal cursor without reaching
+	 * tmux. Toggle the shape to bypass the terminal's OSC 22 cache.
+	 */
+	if (pointer)
+		tty_puts(tty, "\033]22;default\033\\\033]22;pointer\033\\");
+	else
+		tty_puts(tty, "\033]22;default\033\\");
+	tty->mouse_pointer = pointer;
+	tty->mouse_pointer_set = 1;
+}
