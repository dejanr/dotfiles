+static int
+server_client_mouse_hover_enabled(struct client *c)
+{
+	return (c->session != NULL &&
+	    (~c->flags & CLIENT_READONLY) &&
+	    c->overlay_draw == NULL && c->prompt == NULL &&
+	    c->message_string == NULL &&
+	    options_get_number(c->session->options, "mouse") &&
+	    options_get_number(c->session->options, "mouse-hyperlink-hover"));
+}
+
+static void
+server_client_update_mouse_hover(struct client *c, struct mouse_event *m,
+    key_code key)
+{
+	struct window_pane	*wp;
+	u_int			 x, y;
+	char			*link;
+	int			 pointer = 0;
+
+	if (server_client_mouse_hover_enabled(c) &&
+	    (key & KEYC_MASK_KEY) == KEYC_MOUSEMOVE_PANE &&
+	    (m->b & (MOUSE_MASK_CTRL|MOUSE_MASK_SHIFT|MOUSE_MASK_META)) ==
+	    (MOUSE_MASK_CTRL|MOUSE_MASK_SHIFT)) {
+		wp = cmd_mouse_pane(m, NULL, NULL);
+		if (wp != NULL && TAILQ_EMPTY(&wp->modes) &&
+		    cmd_mouse_at(wp, m, &x, &y, 0) == 0) {
+			link = format_grid_hyperlink(wp->base.grid, x,
+			    wp->base.grid->hsize + y, wp->screen);
+			pointer = (link != NULL && *link != '\0');
+			free(link);
+			if (pointer) {
+				c->tty.mouse_pointer_pane = wp->id;
+				c->tty.mouse_pointer_session = c->session->id;
+			}
+		}
+	}
+	tty_mouse_pointer(&c->tty, pointer);
+}
